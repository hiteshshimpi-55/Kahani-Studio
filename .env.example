# Backend URL for the Vite frontend (baked in at build time).
VITE_API_BASE_URL=http://localhost:8000

# External Postgres (Databricks or other). Use asyncpg driver + ssl=require.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/databricks_postgres?ssl=require
DATABASE_URL=

REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
