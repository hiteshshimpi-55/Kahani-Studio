# Backend URL for the Vite frontend (baked in at build time).
VITE_API_BASE_URL=http://localhost:8000

# External Postgres (Databricks or other). Use asyncpg driver + ssl=require.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/databricks_postgres?ssl=require
DATABASE_URL=

REDIS_URL=redis://redis:6379/0
DATA_DIR=/data

# Databricks AI Search (team project context) + cast catalog (Delta Sync)
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_AI_SEARCH_ENDPOINT=
DATABRICKS_AI_SEARCH_INDEX=
DATABRICKS_VECTOR_SEARCH_ENDPOINT=kissa-vector-search
DATABRICKS_VECTOR_SEARCH_INDEX=workspace.kissa.cast_assets_index
DATABRICKS_VECTOR_SEARCH_COLUMNS=id,asset_type,provider_id,name,language,gender,description,preview_url,free_users_allowed
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=kissa
DATABRICKS_CAST_TABLE=cast_assets
DATABRICKS_EMBEDDING_ENDPOINT=databricks-qwen3-embedding-0-6b
# DATABRICKS_SQL_WAREHOUSE_ID=

# Script Writer LLM (falls back to stub screenplay if LLM_API_KEY unset)
# LLM_PROVIDER: openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Default voice provider for cast + TTS: "sarvam" | "elevenlabs"
# Per-request override: POST /api/v1/audiobook/preview { "voice_provider": "elevenlabs" }
# TTS_PROVIDER=elevenlabs

# Sarvam AI (native Hindi TTS — Bulbul v3). Never expose to browser.
# SARVAM_API_KEY=
# SARVAM_DEFAULT_SPEAKER=shubh

# ElevenLabs TTS (api / worker only — never expose to the browser).
# ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_MODEL_ID=eleven_v3
# ELEVENLABS_DEFAULT_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Replicate (identity sheets + face-locked scene stills).
# REPLICATE_API_TOKEN=
# REPLICATE_FACE_MODEL=black-forest-labs/flux-schnell
# REPLICATE_PULID_MODEL=bytedance/flux-pulid:8baa7ef2255075b46f4d91cd238c21d31181b3e6a864463f967960bb0112525b
