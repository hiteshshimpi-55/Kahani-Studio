# Backend URL for the Vite frontend (baked in at build time).
VITE_API_BASE_URL=http://localhost:8000

# External Postgres (Databricks or other). Use asyncpg driver + ssl=require.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/databricks_postgres?ssl=require
DATABASE_URL=

REDIS_URL=redis://redis:6379/0
DATA_DIR=/data

# Databricks AI Search (Direct Access index — create endpoint/index in Databricks first)
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_AI_SEARCH_ENDPOINT=
DATABRICKS_AI_SEARCH_INDEX=
# Optional: serving endpoint used by Direct Access index for embeddings
DATABRICKS_EMBEDDING_ENDPOINT=

# Script Writer LLM (falls back to stub screenplay if LLM_API_KEY unset)
# LLM_PROVIDER: openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ElevenLabs TTS for Editor timeline (stub tones if unset)
ELEVENLABS_API_KEY=
